# Production env for the containerized stack. Copy to `.env` next to
# docker-compose.prod.yml and fill in real values. NEVER commit the filled file —
# .gitignore + .dockerignore already keep .env* out of git and image layers.
#
#   cp .env.production.example .env
#   # edit .env
#   docker compose -f docker-compose.prod.yml up -d --build

# ─── Required ─────────────────────────────────────────────
# Long random strings (e.g. `openssl rand -hex 32`). Rotate to invalidate sessions.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Public origin browsers load the app from — used for CORS. Include the scheme,
# no trailing slash (e.g. https://asta.yourdomain.com).
CLIENT_ORIGIN=http://localhost

# ─── Optional (sensible defaults in compose) ──────────────
# Mongo connection. Defaults to the in-compose replica set; override for Atlas etc.
# MONGO_URI=mongodb://mongo:27017/asta?replicaSet=rs0

# ─── AI: choose ONE for real answers in production ────────
# Without any of these the app runs in honest mock mode (placeholder replies).
#
# A) A cloud key (fastest). Paste any one; AI_PROVIDER=auto picks it up.
# AI_PROVIDER=auto
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
#
# B) Zero-key local AI via Ollama. Run an Ollama container/host reachable from the
#    api service, then:
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434/v1
#
# Force mock explicitly (demo without any AI):
# AI_PROVIDER=mock
