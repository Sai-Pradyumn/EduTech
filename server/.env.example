# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# ─── Database ─────────────────────────────────────────────
# Local dev: a plain standalone mongod is fine. If you point at a replica-set URI
# (recommended for prod) but the replica set isn't reachable, the app automatically
# falls back to a standalone connection. Leave blank to default to local :27017.
MONGO_URI=mongodb://127.0.0.1:27017/asta
# Prod example (transactions/change-streams):
# MONGO_URI=mongodb://localhost:27017/asta?replicaSet=rs0&directConnection=true

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=dev_change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ + cache) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AI providers (multi-provider gateway) ────────────────
# auto → first configured provider in LLM_PROVIDERS wins; or pin a name; 'mock' = no keys.
AI_PROVIDER=auto
# fallback (first healthy wins) | parallel (race + judge synthesize) | refine (draft → critique)
LLM_STRATEGY=fallback
# Priority order for auto-select + the fallback chain.
LLM_PROVIDERS=groq,gemini,mistral,openrouter,deepseek,openai,claude
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=2048
AI_USER_RATE_PER_MIN=20

# Paste ANY one key to go live (the rest stay disabled). Groq/Mistral/OpenRouter/DeepSeek
# are OpenAI-compatible (one adapter); Gemini + Claude have native adapters.
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Model overrides (optional)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-6

# ─── AI feature flags ─────────────────────────────────────
# All default off → mock/dev fallbacks. Turn on once real infra is wired.
ENABLE_LANGGRAPH=false
ENABLE_REALTIME_VOICE=false
ENABLE_FINE_TUNING=false

# ─── Vector store ─────────────────────────────────────────
# keyword | atlas   (keyword fallback needs no vector DB)
VECTOR_STORE_PROVIDER=keyword

# ─── RAG (Knowledge Engine) ───────────────────────────────
RAG_TOP_K=6            # chunks fed to the grounded answer
RAG_MIN_SCORE=0.15     # refusal threshold for the top hit (0..1)
RAG_HYBRID=true        # RRF hybrid retrieval (dense + keyword)

# ─── Storage ──────────────────────────────────────────────
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
