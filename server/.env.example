# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# ─── Database ─────────────────────────────────────────────
# Local dev: a plain standalone mongod is fine. If you point at a replica-set URI
# (recommended for prod) but the replica set isn't reachable, the app automatically
# falls back to a standalone connection. Leave blank to default to local :27017.
MONGO_URI=mongodb://127.0.0.1:27017/asta
# Prod example (transactions/change-streams):
# MONGO_URI=mongodb://localhost:27017/asta?replicaSet=rs0&directConnection=true

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=dev_change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ + cache) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AI providers (multi-provider gateway) ────────────────
# auto → first configured provider in LLM_PROVIDERS wins; or pin a name; 'mock' = no keys.
AI_PROVIDER=auto
# fallback (first healthy wins) | parallel (race + judge synthesize) | refine (draft → critique)
LLM_STRATEGY=fallback
# Priority order for auto-select + the fallback chain (ollama = local, free fallback).
LLM_PROVIDERS=groq,gemini,mistral,openrouter,deepseek,openai,claude,ollama
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=2048
AI_USER_RATE_PER_MIN=20

# Paste ANY one key to go live (the rest stay disabled). Groq/Mistral/OpenRouter/DeepSeek
# are OpenAI-compatible (one adapter); Gemini + Claude have native adapters.
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ─── Ollama: real AI locally with NO API key (free) ───────
# The zero-key path. Install Ollama (https://ollama.com), then:
#   ollama pull llama3.2   &&   ollama serve
# and set OLLAMA_ENABLED=true. It joins the chain as the last real provider before
# the mock fallback, so AI answers are real even with every cloud key blank.
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model overrides (optional)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-6

# ─── AI feature flags ─────────────────────────────────────
# All default off → mock/dev fallbacks. Turn on once real infra is wired.
ENABLE_LANGGRAPH=false
ENABLE_REALTIME_VOICE=false
ENABLE_FINE_TUNING=false

# ─── Vector store ─────────────────────────────────────────
# keyword | atlas   (keyword fallback needs no vector DB)
VECTOR_STORE_PROVIDER=keyword

# ─── RAG (Knowledge Engine) ───────────────────────────────
RAG_TOP_K=6            # chunks fed to the grounded answer
RAG_MIN_SCORE=0.15     # refusal threshold for the top hit (0..1)
RAG_HYBRID=true        # RRF hybrid retrieval (dense + keyword)

# ─── Storage ──────────────────────────────────────────────
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# ── Phase 10 — OAuth / Payments / Web-Push / Queue (all optional; mock when unset) ──
# Google OAuth (Sign in with Google). Create an OAuth Web client at console.cloud.google.com.
GOOGLE_CLIENT_ID=

# Payments. PAYMENT_PROVIDER=razorpay is recommended for INR (flat ~2%, no fixed fee).
# Leave ENABLE_PAYMENT_PROVIDER=false to use the instant mock checkout.
ENABLE_PAYMENT_PROVIDER=false
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe is also supported (set PAYMENT_PROVIDER=stripe). Stripe India adds a fixed fee/txn.
STRIPE_SECRET_KEY=

# Web Push (VAPID). Generate a keypair: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@asta.dev

# Background jobs. Set true only when Redis is reachable (REDIS_HOST/REDIS_PORT).
ENABLE_BULLMQ=false

# ── Email / OTP signup verification ───────────────────────────────────────────
# SMTP for sending OTP codes. Leave blank to log codes to the server console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Asta <no-reply@asta.dev>
# Minutes an OTP code stays valid.
OTP_TTL_MIN=10
# Comma-separated allowlist of email domains accepted at signup (edit freely).
# Leave blank to use the built-in default list (gmail.com, outlook.com, microsoft.com, …).
EMAIL_ALLOWED_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,microsoft.com,yahoo.com,icloud.com,proton.me

# ── Stripe webhook (for PAYMENT_PROVIDER=stripe) ──────────────────────────────
STRIPE_WEBHOOK_SECRET=

# ── Google Calendar OAuth (integrations) ──────────────────────────────────────
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Live sessions: override the Jitsi base (default https://meet.jit.si) ───────
JITSI_BASE_URL=
