# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# ─── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/asta?replicaSet=rs0&directConnection=true

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=dev_change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ + cache) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── AI provider ──────────────────────────────────────────
# mock | openai | gemini | claude   (mock works with no API keys)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ─── AI feature flags ─────────────────────────────────────
# All default off → mock/dev fallbacks. Turn on once real infra is wired.
ENABLE_LANGGRAPH=false
ENABLE_REALTIME_VOICE=false
ENABLE_FINE_TUNING=false

# ─── Vector store ─────────────────────────────────────────
# keyword | atlas   (keyword fallback needs no vector DB)
VECTOR_STORE_PROVIDER=keyword

# ─── RAG (Knowledge Engine) ───────────────────────────────
RAG_TOP_K=6            # chunks fed to the grounded answer
RAG_MIN_SCORE=0.15     # refusal threshold for the top hit (0..1)
RAG_HYBRID=true        # RRF hybrid retrieval (dense + keyword)

# ─── Storage ──────────────────────────────────────────────
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
