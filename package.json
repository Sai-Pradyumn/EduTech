{
  "name": "edu-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Asta — AI Skill Mentor. An AI-native learning operating system (Angular + NestJS + MongoDB).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:server": "npm run start:dev --workspace server",
    "dev:client": "npm run start --workspace client",
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "build": "npm run build:server && npm run build:client",
    "seed": "npm run seed --workspace server",
    "lint": "npm run lint --workspace server && npm run lint --workspace client --if-present",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:cov": "npm run test:cov --workspace server && node scripts/coverage-badge.mjs",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "contrast:audit": "node scripts/contrast-audit.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "prepare": "husky"
  },
  "lint-staged": {
    "server/src/**/*.ts": "eslint --fix --config server/eslint.config.mjs",
    "client/src/**/*.{ts,html}": "eslint --fix --config client/eslint.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "overrides": {
    "dompurify": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
